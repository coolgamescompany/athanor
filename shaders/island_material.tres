[gd_resource type="ShaderMaterial" format=3 uid="uid://b3hat60d218pu"]

[ext_resource type="Texture2D" uid="uid://cykky3mm23yfw" path="res://assets/textures/grass/Grass003_2K-PNG_Color.png" id="2_8algs"]
[ext_resource type="Texture2D" uid="uid://cdrt50h45o6e3" path="res://assets/textures/stone/Rock063_2K-JPG_Color.jpg" id="5_xxgvi"]

[sub_resource type="Shader" id="Shader_hes6n"]
code = "shader_type spatial;

group_uniforms Grass_Settings;
uniform sampler2D grass_albedo : source_color, filter_linear_mipmap_anisotropic;
uniform sampler2D grass_normal : hint_normal, filter_linear_mipmap_anisotropic;
uniform sampler2D grass_roughness : filter_linear_mipmap_anisotropic;
uniform float grass_scale : hint_range(0.01, 10.0) = 1.0;          // Масштаб травы
uniform float grass_normal_bump : hint_range(0.0, 5.0) = 1.0;     // Сила нормали травы
uniform float grass_roughness_strength : hint_range(0.0, 2.0) = 1.0; // Множитель шероховатости травы

group_uniforms Dirt_Settings;
uniform sampler2D dirt_albedo : source_color, filter_linear_mipmap_anisotropic;
uniform sampler2D dirt_normal : hint_normal, filter_linear_mipmap_anisotropic;
uniform sampler2D dirt_roughness : filter_linear_mipmap_anisotropic;
uniform float dirt_scale : hint_range(0.01, 10.0) = 1.0;           // Масштаб грязи
uniform float dirt_normal_bump : hint_range(0.0, 5.0) = 1.0;      // Сила нормали грязи
uniform float dirt_roughness_strength : hint_range(0.0, 2.0) = 1.0;  // Множитель шероховатости грязи

group_uniforms Stone_Settings;
uniform sampler2D stone_albedo : source_color, filter_linear_mipmap_anisotropic;
uniform sampler2D stone_normal : hint_normal, filter_linear_mipmap_anisotropic;
uniform sampler2D stone_roughness : filter_linear_mipmap_anisotropic;
uniform float stone_scale : hint_range(0.01, 10.0) = 1.0;          // Масштаб камня
uniform float stone_normal_bump : hint_range(0.0, 5.0) = 1.0;     // Сила нормали камня
uniform float stone_roughness_strength : hint_range(0.0, 2.0) = 1.0; // Множитель шероховатости камня

group_uniforms Noise_Settings;
uniform sampler2D noise_tex : filter_linear_mipmap_anisotropic;   // Seamless NoiseTexture2D
uniform float noise_scale : hint_range(0.01, 10.0) = 1.0;         // Масштаб пятен грязи
uniform float dirt_amount : hint_range(0.0, 1.0) = 0.5;           // Сколько грязи будет на траве
uniform float dirt_contrast : hint_range(0.1, 20.0) = 2.0;        // Жесткость границ грязи

group_uniforms Global_Settings;
uniform float slope_sharpness : hint_range(0.1, 20.0) = 4.0;      // Резкость перехода камень/земля

// Переменные для передачи чистых данных из vertex в fragment
varying vec3 local_pos;
varying vec3 local_normal;

void vertex() {
	// Здесь VERTEX и NORMAL чисто локальные! Передаем их во фрагмент без искажений камеры.
	local_pos = VERTEX;
	local_normal = NORMAL;
}

vec3 get_triplanar_blend(sampler2D tex, vec3 p, vec3 n, float scale) {
	vec3 blending = abs(n);
	blending = normalize(max(blending, 0.00001));
	float sum = blending.x + blending.y + blending.z;
	blending /= vec3(sum);
	
	// Применяем масштаб к локальным координатам меша
	vec2 uv_x = p.zy * scale;
	vec2 uv_y = p.xz * scale;
	vec2 uv_z = p.xy * scale;
	
	vec3 x_tex = texture(tex, uv_x).rgb;
	vec3 y_tex = texture(tex, uv_y).rgb;
	vec3 z_tex = texture(tex, uv_z).rgb;
	
	return x_tex * blending.x + y_tex * blending.y + z_tex * blending.z;
}

void fragment() {
	// 1. СЭМПЛИРОВАНИЕ ВСЕХ ТЕКСТУР С ИНДИВИДУАЛЬНЫМИ МАСШТАБАМИ
	// Камень
	vec3 s_alb = get_triplanar_blend(stone_albedo, local_pos, local_normal, stone_scale);
	vec3 s_norm = get_triplanar_blend(stone_normal, local_pos, local_normal, stone_scale);
	float s_rough = get_triplanar_blend(stone_roughness, local_pos, local_normal, stone_scale).r;
	
	// Трава
	vec3 g_alb = get_triplanar_blend(grass_albedo, local_pos, local_normal, grass_scale);
	vec3 g_norm = get_triplanar_blend(grass_normal, local_pos, local_normal, grass_scale);
	float g_rough = get_triplanar_blend(grass_roughness, local_pos, local_normal, grass_scale).r;
	
	// Грязь
	vec3 d_alb = get_triplanar_blend(dirt_albedo, local_pos, local_normal, dirt_scale);
	vec3 d_norm = get_triplanar_blend(dirt_normal, local_pos, local_normal, dirt_scale);
	float d_rough = get_triplanar_blend(dirt_roughness, local_pos, local_normal, dirt_scale).r;
	
	// Шум для грязи
	float noise = get_triplanar_blend(noise_tex, local_pos, local_normal, noise_scale).r;

	// РЕГУЛИРОВКА КАРТ НОРМАЛЕЙ И ROUGHNESS
	// Регулировка силы нормалей (корректируем каналы X и Y, оставляя Z направленным вверх)
	s_norm = vec3(s_norm.xy * stone_normal_bump, s_norm.z);
	g_norm = vec3(g_norm.xy * grass_normal_bump, g_norm.z);
	d_norm = vec3(d_norm.xy * dirt_normal_bump, d_norm.z);

	// Регулировка шероховатости (умножаем и зажимаем в стандартный диапазон 0.0 - 1.0)
	s_rough = clamp(s_rough * stone_roughness_strength, 0.0, 1.0);
	g_rough = clamp(g_rough * grass_roughness_strength, 0.0, 1.0);
	d_rough = clamp(d_rough * dirt_roughness_strength, 0.0, 1.0);

	// 2. РАСЧЕТ МАСКИ ГРЯЗИ НА ТРАВЕ
	float dirt_threshold = 1.0 - dirt_amount; 
	float dirt_mask = clamp((noise - dirt_threshold) * dirt_contrast + 0.5, 0.0, 1.0);

	// 3. ПЕРВОЕ СМЕШИВАНИЕ: Накладываем грязь на траву
	vec3 ground_alb = mix(g_alb, d_alb, dirt_mask);
	vec3 ground_norm = mix(g_norm, d_norm, dirt_mask);
	float ground_rough = mix(g_rough, d_rough, dirt_mask);

	// 4. РАСЧЕТ МАСКИ НАКЛОНА (Камень vs Земляной ковер)
	float slope = clamp(dot(normalize(local_normal), vec3(0.0, 1.0, 0.0)), 0.0, 1.0);
	float stone_vs_ground_mask = clamp((slope - 0.5) * slope_sharpness + 0.5, 0.0, 1.0);

	// 5. ВТОРОЕ СМЕШИВАНИЕ: Отделяем вертикальный камень от горизонтальной земли
	ALBEDO = mix(s_alb, ground_alb, stone_vs_ground_mask);
	NORMAL_MAP = mix(s_norm, ground_norm, stone_vs_ground_mask);
	NORMAL_MAP_DEPTH = 1.0; // Гарантирует корректный рендер измененной карты нормалей
	ROUGHNESS = mix(s_rough, ground_rough, stone_vs_ground_mask);
}
"

[resource]
render_priority = 0
shader = SubResource("Shader_hes6n")
shader_parameter/grass_albedo = ExtResource("2_8algs")
shader_parameter/grass_scale = 2.20300010394398
shader_parameter/grass_normal_bump = 1.0
shader_parameter/grass_roughness_strength = 1.0
shader_parameter/dirt_albedo = ExtResource("2_8algs")
shader_parameter/dirt_scale = 0.5510000254739801
shader_parameter/dirt_normal_bump = 1.0
shader_parameter/dirt_roughness_strength = 1.0
shader_parameter/stone_albedo = ExtResource("5_xxgvi")
shader_parameter/stone_scale = 2.97800014075648
shader_parameter/stone_normal_bump = 1.0
shader_parameter/stone_roughness_strength = 1.0
shader_parameter/noise_scale = 0.00999999977648
shader_parameter/dirt_amount = 0.562000026695
shader_parameter/dirt_contrast = 0.90200003958512
shader_parameter/slope_sharpness = 4.0
