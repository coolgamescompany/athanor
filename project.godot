[internationalization]

locale/translations=PackedStringArray("res://translations/translations.en.translation", "res://translations/translations.ru.translation")

[layer_names]

3d_render/layer_17="SimpleGrassTextured interactive layer"

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

textures/canvas_textures/default_texture_filter=2
rendering_device/driver.windows="d3d12"
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/use_taa=true
lights_and_shadows/multi_bounce_occlusion/enabled=true

